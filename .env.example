# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (BullMQ jobs + Socket.IO adapter) — not needed until the
# leaderboard job / comment feed are built; OTP codes live in Postgres.
REDIS_URL="redis://localhost:6379"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=

# SMS provider (phone OTP) — e.g. Termii
TERMII_API_KEY=
TERMII_SENDER_ID=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Cloudinary (profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
