# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (BullMQ jobs + Socket.IO adapter) — the Socket.IO adapter is now
# wired in (see realtime/socket.ts) but fully optional: leave this unset
# and the app runs fine single-instance, in-memory, exactly as before.
# Only matters once/if this backend ever scales to multiple instances.
# Still not needed for the leaderboard job; OTP codes live in Postgres.
REDIS_URL="redis://localhost:6379"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=

# SMS provider (phone OTP) — e.g. Termii
TERMII_API_KEY=
TERMII_SENDER_ID=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Cloudinary (profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (background notifications) — generate with:
# node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log('PUBLIC:',k.publicKey);console.log('PRIVATE:',k.privateKey)"
# VAPID_PUBLIC_KEY must match VITE_VAPID_PUBLIC_KEY in the lucky (frontend) .env — same key, two apps.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
