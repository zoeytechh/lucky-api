// Prisma schema — built incrementally per the implementation plan's build order.
// Step 1 (this file so far): users / auth. Step 2 adds Wallet + LedgerEntry.
// Step 3 adds DrawRound + DrawEntry. Later steps add withdrawals, deposits,
// leaderboard, and comments. See the plan for the full data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SYSTEM
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
}

model User {
  id          String    @id @default(uuid())
  phoneNumber String    @unique @map("phone_number")
  fullName    String?   @map("full_name")
  // Nullable at the DB level: SYSTEM/ADMIN rows are exempt from the
  // mandatory-avatar onboarding gate, which is enforced in the app layer
  // (requireCompleteProfile middleware) for role=USER instead of a DB
  // constraint, since the requirement is role-conditional.
  avatarUrl   String?   @map("avatar_url")
  role        Role      @default(USER)
  kycStatus   KycStatus @default(NONE) @map("kyc_status")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

// Phone OTP codes. Deliberately in Postgres rather than Redis (per the
// plan) so auth doesn't need Redis provisioned before it's otherwise
// needed (BullMQ/leaderboard, Socket.IO) — same security properties
// (hashed, short-lived, attempt-limited), one fewer dependency for now.
model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String    @map("phone_number")
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber, createdAt])
  @@map("otp_codes")
}

// Refresh tokens are stored hashed (never the raw token) so a database
// leak alone can't be used to mint sessions. Rotated on every refresh;
// revoked on logout.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
