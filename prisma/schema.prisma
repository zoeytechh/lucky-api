// Prisma schema — built incrementally per the implementation plan's build order.
// Step 1 (this file so far): users / auth. Step 2 adds Wallet + LedgerEntry.
// Step 3 adds DrawRound + DrawEntry. Later steps add withdrawals, deposits,
// leaderboard, and comments. See the plan for the full data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SYSTEM
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
}

model User {
  id          String    @id @default(uuid())
  phoneNumber String    @unique @map("phone_number")
  fullName    String?   @map("full_name")
  // Nullable at the DB level: SYSTEM/ADMIN rows are exempt from the
  // mandatory-avatar onboarding gate, which is enforced in the app layer
  // (requireCompleteProfile middleware) for role=USER instead of a DB
  // constraint, since the requirement is role-conditional.
  avatarUrl   String?   @map("avatar_url")
  role        Role      @default(USER)
  kycStatus   KycStatus @default(NONE) @map("kyc_status")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  wallet        Wallet?
  drawEntries   DrawEntry[]

  @@map("users")
}

// Phone OTP codes. Deliberately in Postgres rather than Redis (per the
// plan) so auth doesn't need Redis provisioned before it's otherwise
// needed (BullMQ/leaderboard, Socket.IO) — same security properties
// (hashed, short-lived, attempt-limited), one fewer dependency for now.
model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String    @map("phone_number")
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber, createdAt])
  @@map("otp_codes")
}

// Refresh tokens are stored hashed (never the raw token) so a database
// leak alone can't be used to mint sessions. Rotated on every refresh;
// revoked on logout.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum LedgerEntryType {
  DEPOSIT
  DRAW_ENTRY_STAKE
  DRAW_ENTRY_FEE
  DRAW_WINNER_PAYOUT
  DRAW_REFUND
  LEADERBOARD_PRIZE
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
}

// One wallet per user (including the SYSTEM user, which functions as the
// company revenue account — see wallet.service.ts). balanceMinor is a
// cached/derived value: it must only ever be mutated in the same
// transaction as the ledger entry that justifies the change, and must
// always equal SUM(ledgerEntries.amountMinor) — enforced in code and in
// the test suite, not by the database itself.
model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  balanceMinor BigInt   @default(0) @map("balance_minor")
  currency     String   @default("NGN")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@map("wallets")
}

// Append-only. Never updated or deleted — a correction is a new entry,
// never an edit. idempotencyKey is the dedupe mechanism: any retried
// money-moving operation reuses the same key, and the unique constraint
// turns a retry into a safe no-op instead of a double-application.
model LedgerEntry {
  id                String          @id @default(uuid())
  walletId          String          @map("wallet_id")
  wallet            Wallet          @relation(fields: [walletId], references: [id])
  amountMinor       BigInt          @map("amount_minor")
  entryType         LedgerEntryType @map("entry_type")
  // Polymorphic pointer (e.g. referenceType="DRAW_ENTRY", referenceId=<id>)
  // — intentionally not a DB foreign key, since it points at different
  // tables depending on entryType.
  referenceType     String?         @map("reference_type")
  referenceId       String?         @map("reference_id")
  balanceAfterMinor BigInt          @map("balance_after_minor")
  idempotencyKey    String          @unique @map("idempotency_key")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

enum DrawRoundStatus {
  OPEN
  SETTLED
}

// At most one OPEN round ever exists — enforced by a partial unique index
// added by hand to the migration (Prisma schema language can't express a
// filtered/partial unique index), not just application logic.
model DrawRound {
  id          String          @id @default(uuid())
  roundNumber Int             @unique @default(autoincrement()) @map("round_number")
  status      DrawRoundStatus @default(OPEN)
  // CHECK (entry_count BETWEEN 0 AND 1000), also added by hand.
  entryCount  Int             @default(0) @map("entry_count")
  // Soft pointer to the winning DrawEntry — not a formal relation (same
  // reasoning as LedgerEntry.referenceId): avoids a second relation
  // between these two tables just for an audit convenience field.
  winnerEntryId String?       @map("winner_entry_id")
  refundCount Int?            @map("refund_count")
  lossCount   Int?            @map("loss_count")
  // Shuffle algorithm name + full post-shuffle ordering + timestamp, for
  // dispute resolution — see the settlement algorithm in the plan.
  shuffleAudit Json?          @map("shuffle_audit")
  openedAt    DateTime        @default(now()) @map("opened_at")
  settledAt   DateTime?       @map("settled_at")

  entries DrawEntry[]

  @@map("draw_rounds")
}

enum DrawEntryOutcome {
  PENDING
  WON
  REFUNDED
  LOST
}

model DrawEntry {
  id       String    @id @default(uuid())
  roundId  String    @map("round_id")
  round    DrawRound @relation(fields: [roundId], references: [id])
  userId   String    @map("user_id")
  user     User      @relation(fields: [userId], references: [id])
  // UNIQUE(roundId, slotNumber) + CHECK (1..1000), added by hand — the
  // hard DB-level guarantee a round can never exceed 1000 entries or have
  // a gap/duplicate, independent of application logic correctness.
  slotNumber Int      @map("slot_number")

  stakeMinor  BigInt           @map("stake_minor")
  feeMinor    BigInt           @map("fee_minor")
  outcome     DrawEntryOutcome @default(PENDING)
  payoutMinor BigInt?          @map("payout_minor")

  // Client-supplied — makes "place entry" safe to retry on a double-tap.
  idempotencyKey String   @unique @map("idempotency_key")

  enteredAt DateTime  @default(now()) @map("entered_at")
  settledAt DateTime? @map("settled_at")

  @@unique([roundId, slotNumber])
  @@index([outcome, settledAt]) // the "which payouts are still outstanding" query
  @@map("draw_entries")
}
